# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex
# Deployment URL — written to .env.local automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Clerk Frontend API URL / JWT issuer for the Convex JWT template. This must be
# set on the Convex deployment, not only in .env.local:
#   mise exec node@22 -- npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Judge tablet JWT signing secret. Set this on the Convex deployment; it must be
# a strong random string at least 32 characters long:
#   mise exec node@22 -- npx convex env set JUDGE_JWT_SECRET "$(openssl rand -base64 32)"
JUDGE_JWT_SECRET=replace-with-at-least-32-random-characters

# Stripe. Set all Stripe backend values on the Convex deployment for actions,
# Checkout return URL validation, and webhook verification:
#   mise exec node@22 -- npx convex env set STRIPE_SECRET_KEY sk_test_...
#   mise exec node@22 -- npx convex env set STRIPE_CHECKOUT_ALLOWED_ORIGINS https://your-app.example.com,http://localhost:3000
#   mise exec node@22 -- npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
# `STRIPE_CHECKOUT_ALLOWED_ORIGINS` is a comma-separated list of allowed app
# origins for Stripe Checkout success/cancel redirects. `STRIPE_WEBHOOK_SECRET`
# is the signing secret shown when you create the endpoint in the Stripe
# dashboard. The Convex site URL is written by `npx convex dev` and is used by
# the Next.js compatibility proxy.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CHECKOUT_ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:3000
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Sentry
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Anthropic API key (for data extraction script only)
# ANTHROPIC_API_KEY=sk-ant-...
