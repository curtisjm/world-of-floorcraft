# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex
# Deployment URL — written to .env.local automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Clerk Frontend API URL (the JWT issuer domain). Read by convex/auth.config.ts
# so Convex can validate Clerk-issued JWTs. Same value as Clerk's Frontend API
# URL; copy it from https://dashboard.clerk.com/apps/setup/convex
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Stripe (set on the Convex deployment for actions and webhook verification).
# `STRIPE_WEBHOOK_SECRET` is the signing secret shown when you create the
# endpoint in the Stripe dashboard. The Convex site URL is written by
# `npx convex dev` and is used by the Next.js compatibility proxy.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Sentry
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Anthropic API key (for data extraction script only)
# ANTHROPIC_API_KEY=sk-ant-...
